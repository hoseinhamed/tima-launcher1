<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tima_bg"
    android:gravity="center">

    <TextView
        android:id="@+id/logoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TiMa"
        android:textColor="@color/tima_accent"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Each tile is a focusable, TV-remote-friendly button.
             android:nextFocus* keeps D-Pad navigation predictable on a TV box. -->

        <FrameLayout
            android:id="@+id/tileGame"
            android:layout_width="260dp"
            android:layout_height="200dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/tile_background"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/tile_game"
                android:textColor="@color/tima_text"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tileSoftware"
            android:layout_width="260dp"
            android:layout_height="200dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/tile_background"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/tile_software"
                android:textColor="@color/tima_text"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tileAi"
            android:layout_width="260dp"
            android:layout_height="200dp"
            android:background="@drawable/tile_background"
            android:focusable="true"
            android:clickable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/tile_ai"
                android:textColor="@color/tima_text"
                android:textSize="22sp" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
