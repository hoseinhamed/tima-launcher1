<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TimaLauncher"
        android:banner="@mipmap/ic_launcher">

        <!--
          MainActivity is declared as HOME + DEFAULT + LAUNCHER.
          On an Android TV box, once the user picks TiMa as the default Home app
          (Settings > Apps > Default apps > Home app), the device boots directly
          into this screen — exactly the "reboot straight into TiMa" behavior you want.
          No root required on the vast majority of Android TV boxes.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StreamActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

    </application>
</manifest>
